<Project>
  <PropertyGroup>
    <!-- Enable central package management -->
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Enforce versions also on transitive dependencies! -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <!-- Enable floating versions -->
    <!-- This is not recommended but we do use package lock files -->
    <!-- So always review changes to package lock files to prevent pain -->
    <CentralPackageFloatingVersionsEnabled>true</CentralPackageFloatingVersionsEnabled>
    <!-- no overrides allowed, should only exceptionally be enabled -->
    <CentralPackageVersionOverrideEnabled>false</CentralPackageVersionOverrideEnabled>
  </PropertyGroup>

  <!-- package versions -->
  <ItemGroup>
    <!-- jetbrains -->
    <PackageVersion Include="JetBrains.Annotations" Version="2025.2.4" />

    <!-- ppwcode -->
    <PackageVersion Include="PPWCode.Vernacular.Persistence.IV" Version="2.*" />
    <PackageVersion Include="PPWCode.Vernacular.Exceptions.IV" Version="2.*" />
    <PackageVersion Include="PPWCode.Vernacular.Semantics.III" Version="1.*" />

    <!-- system -->
    <PackageVersion Include="System.ComponentModel.Annotations" Version="5.0.0" />

    <!-- nhibernate -->
    <PackageVersion Include="NHibernate" Version="5.*" />
    <PackageVersion Include="NHibernateProfiler.Appender" Version="6.0.*" />
    <PackageVersion Include="NHibernate.Extensions.Logging" Version="4.*" />

    <!-- Firebird -->
    <PackageVersion Include="FirebirdSql.Data.FirebirdClient" Version="10.*" />

    <!-- SQL Server -->
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="7.*" />

    <!-- nunit -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.*" />
    <PackageVersion Include="NUnit" Version="4.*" />
    <PackageVersion Include="NUnit3TestAdapter" Version="6.*" />
    <PackageVersion Include="JunitXml.TestLogger" Version="8.*" />
    <PackageVersion Include="coverlet.collector" Version="10.*" />

    <!-- testing -->
    <PackageVersion Include="Moq" Version="4.*" />

    <!-- Logging -->
    <PackageVersion Include="Serilog" Version="4.*" />
    <PackageVersion Include="Serilog.Sinks.NUnit" Version="1.*" />

    <!-- .net full framework reference assemblies -->
    <!-- these are explicitly added to avoid issues with cross-platform package lock files -->
    <!-- https://github.com/NuGet/Home/issues/9195 -->
    <!-- https://github.com/NuGet/Home/issues/10456 -->
    <!-- https://github.com/dotnet/sdk/issues/26505 -->
    <PackageVersion Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" />
    <PackageVersion Include="Microsoft.NETFramework.ReferenceAssemblies.net462" Version="1.0.3" />
    <PackageVersion Include="Microsoft.NETFramework.ReferenceAssemblies.net47" Version="1.0.3" />
    <PackageVersion Include="Microsoft.NETFramework.ReferenceAssemblies.net471" Version="1.0.3" />
    <PackageVersion Include="Microsoft.NETFramework.ReferenceAssemblies.net472" Version="1.0.3" />
    <PackageVersion Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" />
    <PackageVersion Include="Microsoft.NETFramework.ReferenceAssemblies.net481" Version="1.0.3" />

    <!-- analyzers -->
    <PackageVersion Include="NUnit.Analyzers" Version="4.11.2" />

  </ItemGroup>
  <!-- microsoft: framework dependent -->
  <Choose>
    <When Condition="'$(TargetFramework)' == 'net8.0'">
      <ItemGroup>
        <PackageVersion Include="System.Configuration.ConfigurationManager" Version="8.*" />
        <PackageVersion Include="Microsoft.Extensions.Configuration" Version="8.*" />
        <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="8.*" />
        <PackageVersion Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="8.*" />
        <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="8.*" />
        <PackageVersion Include="Microsoft.Extensions.DependencyModel" Version="8.*" />
        <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.*" />
        <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="8.*" />
        <PackageVersion Include="Microsoft.Extensions.Logging" Version="8.*" />
        <PackageVersion Include="Serilog.Extensions.Logging" Version="8.*" />
        <PackageVersion Include="Serilog.Settings.Configuration" Version="8.*" />

        <!-- PostgreSQL -->
        <PackageVersion Include="Npgsql" Version="10.*" />
      </ItemGroup>
    </When>
    <When Condition="'$(TargetFramework)' == 'net9.0'">
      <ItemGroup>
        <PackageVersion Include="System.Configuration.ConfigurationManager" Version="9.*" />
        <PackageVersion Include="Microsoft.Extensions.Configuration" Version="9.*" />
        <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="9.*" />
        <PackageVersion Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="9.*" />
        <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="9.*" />
        <PackageVersion Include="Microsoft.Extensions.DependencyModel" Version="9.*" />
        <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.*" />
        <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="9.*" />
        <PackageVersion Include="Microsoft.Extensions.Logging" Version="9.*" />
        <PackageVersion Include="Serilog.Extensions.Logging" Version="9.*" />
        <PackageVersion Include="Serilog.Settings.Configuration" Version="9.*" />

        <!-- PostgreSQL -->
        <PackageVersion Include="Npgsql" Version="10.*" />
      </ItemGroup>
    </When>
    <When Condition="'$(TargetFramework)' == 'net10.0'">
      <ItemGroup>
        <PackageVersion Include="System.Configuration.ConfigurationManager" Version="10.*" />
        <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.*" />
        <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.*" />
        <PackageVersion Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.*" />
        <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.*" />
        <PackageVersion Include="Microsoft.Extensions.DependencyModel" Version="10.*" />
        <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.*" />
        <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.*" />
        <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.*" />
        <PackageVersion Include="Serilog.Extensions.Logging" Version="10.*" />
        <PackageVersion Include="Serilog.Settings.Configuration" Version="10.*" />

        <!-- PostgreSQL -->
        <PackageVersion Include="Npgsql" Version="10.*" />
      </ItemGroup>
    </When>
    <Otherwise>
      <!-- versions used on .net full framework -->
      <ItemGroup>
        <PackageVersion Include="System.Configuration.ConfigurationManager" Version="10.*" />
        <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.*" />
        <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.*" />
        <PackageVersion Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.*" />
        <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.*" />
        <PackageVersion Include="Microsoft.Extensions.DependencyModel" Version="10.*" />
        <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.*" />
        <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.*" />
        <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.*" />
        <PackageVersion Include="Serilog.Extensions.Logging" Version="10.*" />
        <PackageVersion Include="Serilog.Settings.Configuration" Version="10.*" />

        <!-- PostgreSQL -->
        <PackageVersion Include="Npgsql" Version="8.*" />
      </ItemGroup>
    </Otherwise>
  </Choose>

  <!-- global package references -->
  <ItemGroup>
    <!-- included in each project, using PrivateAssets="All" -->
    <GlobalPackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556" />
    <GlobalPackageReference Include="Microsoft.SourceLink.GitHub" Version="10.*" />
  </ItemGroup>
</Project>
