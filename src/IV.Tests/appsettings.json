{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "PPWCode.Vernacular.NHibernate.IV": "Information",
        "NHibernate.SQL": "Debug"
      }
    },
    "WriteTo": [
      {
        "Name": "NUnitOutput",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{SourceContext}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "appSettings": {
    "UseProfiler": "false",
    "SuppressProfilingWhileCreatingSchema": "true",
    "ShowSql": "false",
    "FormatSql": "false",
    "GenerateStatistics": "true",
    "FixedConnectionString": null
  }
}
